# westctech.com legacy hosting notes
# Do not redirect this domain to westcoaststonework.com.
# Canonical public domain: https://www.westctech.com/

RewriteEngine On

# Force HTTPS + www if this file is used by Apache hosting.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.westctech\.com$ [NC]
RewriteRule ^(.*)$ https://www.westctech.com/$1 [R=301,L]

# Old/missing URL cleanup
Redirect 301 /index-2.html /
Redirect 301 /faq.html /page.html
Redirect 301 /single.html /page.html
Redirect 301 /blog.html /
Redirect 301 /all_styles.html /portfolio.html
Redirect 301 /edge.html /
Redirect 301 /about.html /aboutus.html
Redirect 301 /contact.html /contacts.html
